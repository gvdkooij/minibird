MINIBIRD_SECRET_KEY=replace-with-long-random-secret
MINIBIRD_DATABASE_URL=sqlite:///./data/minibird.sqlite3
MINIBIRD_HOST=127.0.0.1
MINIBIRD_PORT=8000
# Required for customer routes; generate a unique token of at least 32 characters.
MINIBIRD_ADMIN_TOKEN=
# Weblogin: create/reset the administrator with python -m minibird.admin.
# Secure HTTPS cookies are the default. Set only for local loopback development:
# MINIBIRD_DEV_HTTP=1
